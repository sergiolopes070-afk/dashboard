# Supabase Configuration
# Copie ce fichier en .env.local et remplis les valeurs (Settings → API dans ton projet Supabase)

# URL du projet (ex: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique anon (safe côté client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service role (secret, serveur uniquement — ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=
