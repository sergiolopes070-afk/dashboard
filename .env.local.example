# Supabase Configuration
# Copie ce fichier en .env.local et remplis les valeurs

# URL de ton projet Supabase (ex: https://xxxx.supabase.co)
SUPABASE_URL=

# Clé service_role (Settings → API → service_role secret key)
# ⚠️ Ne jamais exposer cette clé côté client
SUPABASE_SERVICE_ROLE_KEY=

# Email – Resend (https://resend.com → API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Adresse expéditeur (doit être sur un domaine vérifié dans Resend)
RESEND_FROM=KinouClean <noreply@kinouclean.fr>

# URL de base de l'application (pour les appels internes d'API)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
