# Google Sheets API Configuration
# Copie ce fichier en .env.local et remplis les valeurs

# ID de ta Google Spreadsheet (dans l'URL: /spreadsheets/d/SPREADSHEET_ID/)
GOOGLE_SPREADSHEET_ID=

# Clé API Google (ou utilise un compte de service)
GOOGLE_API_KEY=

# Compte de service (JSON encodé en base64) - méthode recommandée
GOOGLE_SERVICE_ACCOUNT_KEY=

# Email du compte de service (ex: kinouclean@projet.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
